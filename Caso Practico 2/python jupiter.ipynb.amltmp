      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "from ydata_profiling import ProfileReport\n",
        "profile = ProfileReport(registros, title=\"Sales Profiling Report\")\n",
        "profile.to_notebook_iframe()\n",
        "profile.to_file('sales_profile_report.html')\n"
