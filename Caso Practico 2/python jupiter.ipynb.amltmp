    {
      "cell_type": "markdown",
      "source": [
        "BORRO LOS 30 OUTLIERS"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "registros.drop(outliers.index,inplace=True)\n",
        "registros.info()"
      ],
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "cell_type": "markdown",
      "source": [
        "CARDINALIDAD"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "def calc_cardinalidad(adf):\n",
        "    result = {}\n",
        "    for col in adf.columns:\n",
        "        print('\\n- Valores únicos para \"{0}\"'.format(col), '\\n')\n",
        "        # print(adf[col].unique())\n",
        "        card = len(adf[col].unique())\n",
        "        print('Num valores únicos: ', len(adf[col].unique()))\n",
        "        result[col] = card\n",
        "    return result\n",
        "registros_card = calc_cardinalidad(registros)\n",
        "print(registros_card)"
      ],
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "for col in registros.columns:\n",
        "    print('frecuencia para: \"{0}\"'.format(col),\"\\n\")\n",
        "    print(registros[col].value_counts())"
      ],
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "cell_type": "markdown",
      "source": [
        "ANALISIS DE CORRELACION"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "registros.corr(method=\"pearson\",numeric_only=True)"
      ],
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "cell_type": "markdown",
      "source": [
        "ANALISIS SESGO"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "registros_skw=registros.skew(numeric_only=True)\n",
        "registros_skw"
      ],
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "cell_type": "markdown",
      "source": [
        "KURTOSIS"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "registros_kurt = registros.kurt(numeric_only=True)\n",
        "registros_kurt"
      ],
      "outputs": [],
      "execution_count": null,
      "metadata": {}
    },
    {
      "cell_type": "markdown",
      "source": [
