    },
    {
      "cell_type": "markdown",
      "source": [
        "VALORES ATIPICOS"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "z_scores = (ordenes-ordenes.mean(numeric_only=True))/ordenes.std(numeric_only=True)\n",
        "z_scores_abs = z_scores.apply(np.abs)\n",
        "#print(tabulate(z_scores_abs, headers='keys'))\n",
        "umbral = 3\n",
        "out_mask = ~z_scores[z_scores_abs > umbral].isna()\n",
        "print(out_mask.sum())\n",
        "\n"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Costo_Mantenimiento    0\nDuracion_Horas         0\nFecha                  0\nID_Equipo              0\nID_Orden               0\nTipo_Mantenimiento     0\nUbicacion              0\ndtype: int64\n"
        }
      ],
      "execution_count": 49,
      "metadata": {}
    },
    {
      "cell_type": "markdown",
      "source": [
        "CARDINALIDAD"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "def calc_cardinalidad(adf):\n",
        "    result = {}\n",
        "    for col in adf.columns:\n",
        "        print('\\n- Valores únicos para \"{0}\"'.format(col), '\\n')\n",
        "        # print(adf[col].unique())\n",
        "        card = len(adf[col].unique())\n",
        "        print('Num valores únicos: ', len(adf[col].unique()))\n",
        "        result[col] = card\n",
        "    return result\n",
        "ordenes_card = calc_cardinalidad(ordenes)\n",
        "print(ordenes_card)"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "\n- Valores únicos para \"ID_Orden\" \n\nNum valores únicos:  9950\n\n- Valores únicos para \"ID_Equipo\" \n\nNum valores únicos:  499\n\n- Valores únicos para \"Fecha\" \n\nNum valores únicos:  9950\n\n- Valores únicos para \"Tipo_Mantenimiento\" \n\nNum valores únicos:  2\n\n- Valores únicos para \"Costo_Mantenimiento\" \n\nNum valores únicos:  9888\n\n- Valores únicos para \"Duracion_Horas\" \n\nNum valores únicos:  47\n\n- Valores únicos para \"Ubicacion\" \n\nNum valores únicos:  4\n{'ID_Orden': 9950, 'ID_Equipo': 499, 'Fecha': 9950, 'Tipo_Mantenimiento': 2, 'Costo_Mantenimiento': 9888, 'Duracion_Horas': 47, 'Ubicacion': 4}\n"
        }
      ],
