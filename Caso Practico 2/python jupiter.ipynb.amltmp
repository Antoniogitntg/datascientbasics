    {
      "cell_type": "markdown",
      "source": [
        "VALORES ATIPICOS"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "z_scores = (caracteristicas-caracteristicas.mean(numeric_only=True))/caracteristicas.std(numeric_only=True)\n",
        "z_scores_abs = z_scores.apply(np.abs)\n",
        "#print(tabulate(z_scores_abs, headers='keys'))\n",
        "umbral = 3\n",
        "out_mask = ~z_scores[z_scores_abs > umbral].isna()\n",
        "print(out_mask.sum())"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "Fabricante                     0\nHoras_Recomendadas_Revision    0\nID_Equipo                      0\nModelo                         0\nPotencia_kW                    0\nTipo_Equipo                    0\ndtype: int64\n"
        }
      ],
      "execution_count": 48,
      "metadata": {}
    },
    {
      "cell_type": "markdown",
      "source": [
        "CARDINALIDAD"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "def calc_cardinalidad(adf):\n",
        "    result = {}\n",
        "    for col in adf.columns:\n",
        "        print('\\n- Valores únicos para \"{0}\"'.format(col), '\\n')\n",
        "        # print(adf[col].unique())\n",
        "        card = len(adf[col].unique())\n",
        "        print('Num valores únicos: ', len(adf[col].unique()))\n",
        "        result[col] = card\n",
        "    return result\n",
        "caracteristicas_card = calc_cardinalidad(caracteristicas)\n",
        "print(caracteristicas_card)"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": "\n- Valores únicos para \"ID_Equipo\" \n\nNum valores únicos:  500\n\n- Valores únicos para \"Tipo_Equipo\" \n\nNum valores únicos:  4\n\n- Valores únicos para \"Fabricante\" \n\nNum valores únicos:  4\n\n- Valores únicos para \"Modelo\" \n\nNum valores únicos:  4\n\n- Valores únicos para \"Potencia_kW\" \n\nNum valores únicos:  471\n\n- Valores únicos para \"Horas_Recomendadas_Revision\" \n\nNum valores únicos:  490\n{'ID_Equipo': 500, 'Tipo_Equipo': 4, 'Fabricante': 4, 'Modelo': 4, 'Potencia_kW': 471, 'Horas_Recomendadas_Revision': 490}\n"
        }
      ],
