      "cell_type": "markdown",
      "source": [
        "VALORES ATIPICOS"
      ],
      "metadata": {}
    },
    {
      "cell_type": "code",
      "source": [
        "z_scores = (registros-registros.mean(numeric_only=True))/registros.std(numeric_only=True)\n",
        "z_scores_abs = z_scores.apply(np.abs)\n",
        "#print(tabulate(z_scores_abs, headers='keys'))\n",
        "umbral = 3\n",
        "out_mask = ~z_scores[z_scores_abs > umbral].isna()\n",
        "print(out_mask.sum())\n",
        "outliers = registros['Temperatura_C'][out_mask['Temperatura_C']]\n",
        "outliers"
      ],
      "outputs": [
        {
